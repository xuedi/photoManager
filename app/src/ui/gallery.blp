using Gtk 4.0;
using Adw 1;

template $PmGallery: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split.collapsed: true;
      toolbar.orientation: vertical;
    }
  }

  child: Adw.ToastOverlay toasts {
    child: Adw.NavigationView nav {
      Adw.NavigationPage {
        title: "Gallery";
        tag: "grid";

        child: Adw.OverlaySplitView split {
          sidebar-width-fraction: 0.28;
          min-sidebar-width: 220;
          max-sidebar-width: 340;

          sidebar: Box {
            orientation: vertical;

            Adw.ToggleGroup browse_by {
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 6;
              margin-end: 6;
              active-name: "places";

              Adw.Toggle {
                name: "places";
                label: "Places";
                tooltip: "Folders and events";
              }

              Adw.Toggle {
                name: "tags";
                label: "Tags";
                tooltip: "The tag tree";
              }

              Adw.Toggle {
                name: "people";
                label: "People";
                tooltip: "Who the photos name";
              }
            }

            Stack sidebars {
              vexpand: true;

              StackPage {
                name: "places";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  child: ListView places_list {
                    single-click-activate: true;

                    styles [
                      "navigation-sidebar",
                    ]

                    accessibility {
                      label: "Places";
                    }
                  };
                };
              }

              StackPage {
                name: "tags";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  child: ListView tags_list {
                    single-click-activate: true;

                    styles [
                      "navigation-sidebar",
                    ]

                    accessibility {
                      label: "Tags";
                    }
                  };
                };
              }

              StackPage {
                name: "people";

                child: Box {
                  orientation: vertical;

                  SearchEntry people_search {
                    placeholder-text: "Search People";
                    margin-start: 6;
                    margin-end: 6;
                    margin-bottom: 6;

                    accessibility {
                      label: "Search People";
                    }
                  }

                  ScrolledWindow {
                    hscrollbar-policy: never;
                    vexpand: true;

                    child: ListView people_list {
                      single-click-activate: true;

                      styles [
                        "navigation-sidebar",
                      ]

                      accessibility {
                        label: "People";
                      }
                    };
                  }

                  Adw.StatusPage people_empty {
                    visible: false;
                    vexpand: true;
                    icon-name: "avatar-default-symbolic";
                    title: "No People";
                    description: "No photo names a person yet.";

                    styles [
                      "compact",
                    ]
                  }
                };
              }
            }
          };

          content: Box {
            orientation: vertical;

            Box toolbar {
              orientation: horizontal;
              spacing: 6;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 6;
              margin-end: 6;

              Box {
                orientation: horizontal;
                spacing: 6;
                hexpand: true;

                ToggleButton sidebar_button {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: "Show the Sidebar";
                  valign: center;
                  active: bind split.show-sidebar bidirectional;

                  accessibility {
                    label: "Show the Sidebar";
                  }
                }

                Box {
                  orientation: vertical;
                  hexpand: true;
                  valign: center;

                  Label title {
                    xalign: 0;
                    ellipsize: middle;

                    styles [
                      "heading",
                    ]
                  }

                  Label count {
                    xalign: 0;

                    styles [
                      "caption",
                      "dim-label",
                    ]
                  }
                }
              }

              Box {
                orientation: horizontal;
                spacing: 6;
                halign: end;

                DropDown gap {
                  valign: center;
                  tooltip-text: "Only the photos missing a field";

                  accessibility {
                    label: "Missing Field";
                  }
                }

                DropDown sort {
                  valign: center;
                  tooltip-text: "Sort by";

                  accessibility {
                    label: "Sort By";
                  }
                }
              }
            }

            Adw.WrapBox chips {
              visible: false;
              child-spacing: 6;
              line-spacing: 6;
              margin-bottom: 6;
              margin-start: 6;
              margin-end: 6;

              accessibility {
                label: "Filter";
              }
            }

            Separator {}

            Stack pages {
              vexpand: true;

              StackPage {
                name: "grid";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  child: GridView grid {
                    max-columns: 8;
                    min-columns: 2;
                    enable-rubberband: true;

                    accessibility {
                      label: "Photos";
                    }
                  };
                };
              }

              StackPage {
                name: "files";

                child: ScrolledWindow {
                  child: ListView files {
                    styles [
                      "rich-list",
                    ]

                    accessibility {
                      label: "Files";
                    }
                  };
                };
              }

              StackPage {
                name: "empty";

                child: Adw.StatusPage empty {
                  icon-name: "image-x-generic-symbolic";
                  title: "No Photos";
                  description: "Nothing here matches. Pick another place, tag or field.";
                };
              }
            }

            ActionBar selection_bar {
              revealed: false;

              [start]
              Label selected {
                ellipsize: end;
              }

              [end]
              Button scope_button {
                label: "Use as Scope";
                action-name: "win.use-as-scope";

                styles [
                  "suggested-action",
                ]

                accessibility {
                  label: "Use as Scope";
                }
              }

              [end]
              Button select_none_button {
                label: "Select None";
                action-name: "win.gallery-select-none";

                accessibility {
                  label: "Select None";
                }
              }

              [end]
              Button select_all_button {
                label: "Select All";
                action-name: "win.gallery-select-all";

                accessibility {
                  label: "Select All";
                }
              }
            }
          };
        };
      }

      $PmPhotoPage photo {}
    };
  };
}
