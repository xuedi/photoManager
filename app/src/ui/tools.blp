using Gtk 4.0;
using Adw 1;

template $PmTools: Adw.Bin {
  child: Adw.ToastOverlay toasts {
    child: Adw.NavigationView nav {
      Adw.NavigationPage {
        title: "Tools";
        tag: "tools";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 720;

            child: Box {
              orientation: vertical;
              spacing: 24;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              Adw.PreferencesGroup scope_group {
                title: "Scope";
                description: "What the tools work on";

                Adw.ActionRow scope_row {
                  title: "Whole Library";
                  activatable: true;

                  [suffix]
                  Image {
                    icon-name: "go-next-symbolic";
                    accessible-role: presentation;
                  }
                }
              }

              Adw.PreferencesGroup tools_group {
                title: "Tools";
                description: "Each writes a value you give to every photo of the scope, after a preview";
              }

              Adw.StatusPage empty {
                visible: false;
                icon-name: "applications-engineering-symbolic";
                title: "No Tools Yet";
                description: "Edits that write a place, a date, a tag or a folder to many photos at once will be listed here.";

                styles [
                  "compact",
                ]
              }
            };
          };
        };
      }

      Adw.NavigationPage {
        title: "Position from a Neighbour";
        tag: "neighbour";

        child: $PmNeighbour neighbour {};
      }

      Adw.NavigationPage {
        title: "Preview";
        tag: "preview";

        child: $PmPreview preview {};
      }
    };
  };
}
