using Gtk 4.0;
using Adw 1;

template $PmDashboard: Adw.Bin {
  child: Adw.ToastOverlay toasts {
    child: Stack pages {
      transition-type: crossfade;

      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "view-grid-symbolic";
          title: "Dashboard";
          description: "What the library holds and what it is missing.";

          child: Box empty_slot {
            orientation: vertical;
            halign: center;

            Box controls {
              orientation: vertical;
              spacing: 12;

              Box bar {
                homogeneous: true;

                styles [
                  "linked",
                ]
              }

              Box busy {
                spacing: 12;
                visible: false;

                ProgressBar progress {
                  show-text: true;
                  hexpand: true;
                  valign: center;
                }

                Button cancel_button {
                  label: "Cancel";
                  action-name: "win.cancel-scan";
                  valign: center;

                  accessibility {
                    label: "Cancel";
                  }
                }
              }
            }
          };
        };
      }

      StackPage {
        name: "filled";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 860;
            tightening-threshold: 600;

            child: Box {
              orientation: vertical;
              spacing: 24;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              Box filled_slot {
                orientation: vertical;
              }

              Adw.PreferencesGroup suggested {
                visible: false;

                Adw.ActionRow suggested_row {
                  subtitle: "Ready-made fixes, each opened in its tool";
                  activatable: true;
                  action-name: "win.show-view";
                  action-target: "'suggestions'";

                  [suffix]
                  Image {
                    icon-name: "go-next-symbolic";
                    accessible-role: presentation;
                  }
                }
              }

              Box {
                orientation: vertical;
                spacing: 12;

                Label {
                  label: "At a Glance";
                  xalign: 0;

                  styles [
                    "heading",
                  ]
                }

                FlowBox glance {
                  selection-mode: none;
                  homogeneous: true;
                  min-children-per-line: 1;
                  max-children-per-line: 3;
                  column-spacing: 12;
                  row-spacing: 12;
                }
              }

              Adw.PreferencesGroup coverage {
                title: "Coverage";
                description: "How many photos carry each field. Select one to see the photos without it.";
              }

              Adw.PreferencesGroup places {
                title: "Where the Gaps Are";
                description: "Folders and events, the most missing first.";

                header-suffix: DropDown field {
                  valign: center;
                  tooltip-text: "The field to look at";

                  accessibility {
                    label: "Field";
                  }
                };
              }

              Adw.PreferencesGroup tidy {
                title: "Tidy Up";
                description: "Things that are untidy rather than missing. Each is fixed by a tool.";
              }
            };
          };
        };
      }
    };
  };
}
